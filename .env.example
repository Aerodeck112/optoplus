APP_NAME="Optoplus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Bucharest
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

# Cheie HMAC pentru indexurile oarbe (căutare după email/telefon fără a le stoca în clar în index). Generată la instalare, diferită de APP_KEY.
OPTOPLUS_BLIND_INDEX_KEY=
# Directorul „shared” din afara public_html (în producție: /home/<cont>/optoplus/shared)
OPTOPLUS_SHARED_PATH=
# Mediu: production | staging | local (staging afișează o bandă de avertizare și blochează trimiterile reale)
OPTOPLUS_STAGE=local

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=optoplus
DB_USERNAME=optoplus
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Optoplus"

# Actualizări și backup (vezi docs/INSTALARE-CPANEL.md). Goale în dezvoltare.
OPTOPLUS_DEPLOY_PATH=
OPTOPLUS_PUBLIC_PATH=
OPTOPLUS_UPDATE_STEP_BUDGET=15
OPTOPLUS_BACKUP_AT=02:30
OPTOPLUS_BACKUP_RETAIN_DB=14
OPTOPLUS_BACKUP_RETAIN_DOCS=8
# Plafon de spațiu liber (octeți) când cota contului e mai mică decât discul raportat; 0 = fără plafon.
OPTOPLUS_DISK_FREE_CAP=0
